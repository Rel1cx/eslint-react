{
  "name": "@eslint-react/kit",
  "version": "5.30.0-beta.9",
  "description": "ESLint React's utility module for building custom React rules with JavaScript functions.",
  "keywords": [
    "react",
    "eslint",
    "eslint-react",
    "@eslint-react/kit"
  ],
  "homepage": "https://github.com/Rel1cx/eslint-react",
  "bugs": {
    "url": "https://github.com/Rel1cx/eslint-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rel1cx/eslint-react.git",
    "directory": "packages/kit"
  },
  "license": "MIT",
  "author": "Rel1cx",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build:docs": "typedoc",
    "lint:publish": "publint",
    "lint:ts": "tsl",
    "publish": "node --run build && node --run lint:publish"
  },
  "dependencies": {
    "@eslint-react/ast": "workspace:*",
    "@eslint-react/core": "workspace:*",
    "@eslint-react/shared": "workspace:*",
    "@typescript-eslint/types": "^8.72.1",
    "@typescript-eslint/utils": "^8.72.1",
    "string-ts": "^2.3.1"
  },
  "devDependencies": {
    "@eslint-react/eslint": "workspace:*",
    "@local/configs": "workspace:*",
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "^20.19.43",
    "eslint": "^10.13.0",
    "tsdown": "^0.23.2",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "eslint": "*",
    "typescript": "*"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
