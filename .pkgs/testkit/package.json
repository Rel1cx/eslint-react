{
  "name": "@local/testkit",
  "version": "0.0.0",
  "private": true,
  "description": "Shared test construction kit for ESLint React's unit tests and rule tests.",
  "homepage": "https://github.com/Rel1cx/eslint-react",
  "bugs": {
    "url": "https://github.com/Rel1cx/eslint-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rel1cx/eslint-react.git",
    "directory": ".pkgs/testkit"
  },
  "license": "MIT",
  "author": "Rel1cx",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "build:docs": "typedoc",
    "lint:publish": "publint",
    "lint:ts": "tsl",
    "publish": "node --run build:docs && node --run lint:publish"
  },
  "dependencies": {
    "@local/eff": "workspace:*",
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript-eslint/rule-tester": "^8.71.2",
    "@typescript-eslint/types": "^8.71.2",
    "@typescript-eslint/typescript-estree": "^8.71.2",
    "@typescript-eslint/utils": "^8.71.2"
  },
  "devDependencies": {
    "@local/configs": "workspace:*",
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "^20.19.43",
    "eslint": "^10.12.0",
    "tsdown": "^0.23.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
