{
  "name": "@local/configs",
  "version": "0.0.0",
  "private": true,
  "description": "Local config bases for use in the workspace",
  "homepage": "https://github.com/Rel1cx/eslint-react",
  "bugs": {
    "url": "https://github.com/Rel1cx/eslint-react/issues"
  },
  "license": "MIT",
  "author": "Rel1cx",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./eslint": {
      "types": "./eslint.d.ts",
      "import": "./eslint.js"
    },
    "./textlint": {
      "types": "./textlint.d.ts",
      "import": "./textlint.js"
    },
    "./textlint.base.json": "./textlint.base.json",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsdown.config.base": {
      "types": "./tsdown.config.base.d.ts",
      "import": "./tsdown.config.base.js"
    },
    "./tsl.config.base": {
      "types": "./tsl.config.base.d.ts",
      "import": "./tsl.config.base.js"
    },
    "./typedoc.base.json": "./typedoc.base.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint:publish": "publint",
    "lint:ts": "tsl"
  },
  "dependencies": {
    "@eslint/config-helpers": "^0.7.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tsconfig/strictest": "^2.0.8",
    "eslint-plugin-de-morgan": "^2.3.0",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-unicorn": "^74.0.0",
    "typescript-eslint": "^8.72.1"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "^20.19.43",
    "eslint": "^10.13.0",
    "tinyglobby": "^0.2.17",
    "tsdown": "^0.23.2",
    "tsl": "^1.0.30",
    "tsl-dx": "^0.15.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-file-overview": "^0.2.0",
    "typedoc-plugin-markdown": "^4.14.1",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "eslint": "*",
    "tsl": "^1.0.30",
    "tsl-dx": "^0.14.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typescript": "*"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
