{
  "lineWidth": 160,
  "typescript": {
    "indentWidth": 2,
    "quoteStyle": "preferDouble",
    "quoteProps": "asNeeded",
    "importDeclaration.sortNamedImports": "caseSensitive",
    "exportDeclaration.sortNamedExports": "caseSensitive",
    "module.sortImportDeclarations": "caseSensitive",
    "module.sortExportDeclarations": "caseSensitive"
  },
  "json": {
    "indentWidth": 2
  },
  "yaml": {
    "indentWidth": 2
  },
  "markdown": {},
  "excludes": [
    "**/*-lock.json",
    "**/*-lock.yaml",
    "**/.next",
    "**/dist",
    "**/node_modules",
    "**/testing/samples",
    ".pkgs/**/*.d.ts",
    ".pkgs/**/*.js"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.23.0",
    "npm:@dprint/markdown@0.23.2",
    "npm:@dprint/toml@0.8.0",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.3",
    "npm:dprint-plugin-yaml@0.6.0"
  ]
}
